{
  "name": "docs-site",
  "version": "0.0.28",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "gen:api": "node scripts/gen-api-reference.mjs",
    "gen:api:check": "node scripts/gen-api-reference.mjs --check",
    "gen:api:report": "node scripts/gen-api-reference.mjs --report",
    "check:links": "node scripts/check-links.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:share-code": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-share-code.mjs",
    "check:mod-settings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-mod-settings.mjs",
    "check": "npm run gen:api:check && npm run check:links && npm run check:versions && npm run check:share-code && npm run check:mod-settings"
  },
  "dependencies": {
    "cn": "^0.2.6",
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.10",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
